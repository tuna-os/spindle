+    // With `direct_names`, only a node id rides the proxy (and gets the
+    // sentinel); a named peer is dialled verbatim, since a datagram link
+    // cannot address a hostname.
+    #[test]
+    fn direct_names_routes_only_node_ids_through_the_proxy() {
+        let client = FederationClient::new("origin".to_owned(), Some("http://127.0.0.1:1"))
+            .with_direct_names(true);
+        let name = |s: &str| <&ServerName>::try_from(s).unwrap().to_owned();
+        let node = "a".repeat(64);
+        assert!(client.via_proxy(&name(&node)));
+        assert_eq!(client.url_authority(&name(&node)), format!("{node}~"));
+        assert!(!client.via_proxy(&name("gateway.example:8008")));
+        assert_eq!(
+            client.url_authority(&name("gateway.example:8008")),
+            "gateway.example:8008"
+        );
+    }
+
+    // A signer turns the header into a real X-Matrix signature over the
+    // request object, under the key id the key document advertises.
+    #[test]
+    fn x_matrix_is_signed_when_a_signer_is_set() {
+        let signer = Arc::new(EventSigner::new(&[7u8; 32], "origin"));
+        let client =
+            FederationClient::new("origin".to_owned(), None).with_signer(Some(signer.clone()));
+        let name = |s: &str| <&ServerName>::try_from(s).unwrap().to_owned();
+        let header = client.x_matrix(
+            &name("peer.example"),
+            "PUT",
+            "/_matrix/federation/v1/send/1",
+            Some(&serde_json::json!({"pdus": []})),
+        );
+        assert!(header.starts_with(
+            "X-Matrix origin=\"origin\",destination=\"peer.example\",key=\"ed25519:1\",sig=\""
+        ));
+        let sig = header
+            .rsplit("sig=\"")
+            .next()
+            .unwrap()
+            .trim_end_matches('"');
+        let obj = match ruma::CanonicalJsonValue::try_from(serde_json::json!({
+            "method": "PUT", "uri": "/_matrix/federation/v1/send/1", "origin": "origin",
+            "destination": "peer.example", "content": {"pdus": []}
+        })) {
+            Ok(ruma::CanonicalJsonValue::Object(o)) => o,
+            _ => unreachable!(),
+        };
+        assert_eq!(
+            sig,
+            signer.sign_bytes(&neutrino_event::sign::signable_json_bytes(&obj))
+        );
+    }
