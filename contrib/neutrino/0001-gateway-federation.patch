+    /// The `Authorization: X-Matrix …` header value for an outbound request
+    /// to `dest`. With a signer: `origin`, `destination`, `key` and `sig`,
+    /// the signature being over the canonical JSON of `{method, uri, origin,
+    /// destination[, content]}` (Server-Server API, "Request authentication").
+    /// Without one: `origin` and `destination` only — a network-attested
+    /// identity, not a signature (see [`crate::federation::auth`]). Server
+    /// names contain no `"`/`,`, so the values need no escaping.
+    fn x_matrix(
+        &self,
+        dest: &ServerName,
+        method: &str,
+        uri: &str,
+        content: Option<&Value>,
+    ) -> String {
+        let Some(signer) = &self.signer else {
+            return format!(
+                "X-Matrix origin=\"{}\",destination=\"{}\"",
+                self.origin, dest
+            );
+        };
+        let mut object = serde_json::json!({
+            "method": method,
+            "uri": uri,
+            "origin": self.origin,
+            "destination": dest.as_str(),
+        });
+        if let Some(content) = content {
+            object["content"] = content.clone();
+        }
+        let sig = match ruma::CanonicalJsonValue::try_from(object) {
+            Ok(ruma::CanonicalJsonValue::Object(obj)) => {
+                signer.sign_bytes(&neutrino_event::sign::signable_json_bytes(&obj))
+            }
+            // A body that is not canonical-JSON-safe (a float, a huge int)
+            // cannot be signed; send the unsigned form and let the peer
+            // refuse it, rather than fail the whole request here.
+            _ => {
+                warn!(target: "neutrino_http", %dest, "request body is not canonical JSON; sending unsigned X-Matrix");
+                return format!(
+                    "X-Matrix origin=\"{}\",destination=\"{}\"",
+                    self.origin, dest
+                );
+            }
+        };
         format!(
-            "X-Matrix origin=\"{}\",destination=\"{}\"",
-            self.origin, dest
+            "X-Matrix origin=\"{}\",destination=\"{}\",key=\"{}\",sig=\"{}\"",
+            self.origin,
+            dest,
+            neutrino_event::SIGNING_KEY_ID,
+            sig
         )
     }
 
