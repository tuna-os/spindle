new file mode 100644
index 0000000..b9cf198
--- /dev/null
+++ b/crates/neutrino-main/src/keys.rs
@@ -0,0 +1,163 @@
+//! Key resolution for a node that federates beyond its own medium.
+//!
+//! On the datagram link a peer's `server_name` *is* its verify key
+//! ([`NodeIdKeyResolver`]). A peer reached by name — a venue gateway's
+//! upstream homeserver, an ordinary Matrix server — publishes its keys at
+//! `/_matrix/key/v2/server` instead. [`HttpKeyResolver`] tries the medium's
+//! resolver first and falls back to fetching that document over plain HTTP
+//! for any name the medium does not understand.
+//!
+//! Scope: the document is fetched from the name itself (`http://{name}`),
+//! with no `.well-known` / SRV delegation and no TLS — the same stance as
+//! the outbound federation client, and enough for a gateway whose upstream
+//! is one host the operator configured. The document's own signature is
+//! checked against the key it advertises before the key is trusted, and a
+//! resolved key is cached until the document's `valid_until_ts`.
+
+use std::collections::HashMap;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use neutrino_event::{KeyResolveError, KeyResolver};
+use tracing::{debug, warn};
+
+/// How long a fetched key is kept when the document names no
+/// `valid_until_ts` (or one already in the past — the spec says to treat
+/// such a key as usable for events before that time, but we have no use
+/// for it beyond the fetch that found it).
+const FALLBACK_TTL_MS: u64 = 60 * 60 * 1000;
+
+struct Cached {
+    key: [u8; 32],
+    expires_ms: u64,
+}
+
+pub struct HttpKeyResolver {
+    medium: Arc<dyn KeyResolver>,
+    http: reqwest::Client,
+    cache: Mutex<HashMap<(String, String), Cached>>,
+}
+
+impl HttpKeyResolver {
+    /// Wrap the medium's resolver; anything it rejects is fetched by name.
+    pub fn new(medium: Arc<dyn KeyResolver>) -> Self {
+        let http = reqwest::Client::builder()
+            .connect_timeout(Duration::from_secs(10))
+            .timeout(Duration::from_secs(30))
+            .no_proxy()
+            .build()
+            .expect("plaintext reqwest client always builds; no TLS backend to init");
+        Self {
+            medium,
+            http,
+            cache: Mutex::new(HashMap::new()),
+        }
+    }
+
+    async fn fetch(&self, server_name: &str, key_id: &str) -> Result<[u8; 32], KeyResolveError> {
+        let err = |reason: String| KeyResolveError {
+            server_name: server_name.to_owned(),
+            key_id: key_id.to_owned(),
+            reason,
+        };
+        // Only a plausible authority is dialled: a name with a scheme, a
+        // path, or whitespace is not a host.
+        if server_name.is_empty()
+            || server_name.contains(|c: char| c == '/' || c == '?' || c == '#' || c.is_whitespace())
+        {
+            return Err(err("server name is not an authority".to_owned()));
+        }
+        let url = format!("http://{server_name}/_matrix/key/v2/server");
+        let bytes = self
+            .http
+            .get(&url)
+            .send()
+            .await
+            .and_then(|r| r.error_for_status())
+            .map_err(|e| err(format!("key document fetch failed: {e}")))?
+            .bytes()
+            .await
+            .map_err(|e| err(format!("key document read failed: {e}")))?;
+        let doc: serde_json::Value = serde_json::from_slice(&bytes)
+            .map_err(|e| err(format!("key document is not JSON: {e}")))?;
+        if doc.get("server_name").and_then(|v| v.as_str()) != Some(server_name) {
+            return Err(err("key document names a different server".to_owned()));
+        }
+        let key_b64 = doc
+            .get("verify_keys")
+            .and_then(|v| v.get(key_id))
+            .and_then(|v| v.get("key"))
+            .and_then(|v| v.as_str())
+            .ok_or_else(|| err(format!("key document has no verify key {key_id}")))?;
+        let key: [u8; 32] = neutrino_event::sign::b64_decode(key_b64)
+            .ok()
+            .and_then(|k| k.try_into().ok())
+            .ok_or_else(|| err("verify key is not 32 base64 bytes".to_owned()))?;
+        // The document must be signed by the key it advertises, or anyone on
+        // the path could hand us a key of their own.
+        let obj = match neutrino_event::ruma::CanonicalJsonValue::try_from(doc.clone()) {
+            Ok(neutrino_event::ruma::CanonicalJsonValue::Object(o)) => o,
+            _ => return Err(err("key document is not canonical JSON".to_owned())),
+        };
+        let resolver = FixedKey(key);
+        neutrino_event::sign::verify_json_signature(&obj, server_name, key_id, &resolver)
+            .await
+            .map_err(|e| err(format!("key document signature: {e}")))?;
+        let expires_ms = doc
+            .get("valid_until_ts")
+            .and_then(|v| v.as_u64())
+            .filter(|ts| *ts > neutrino_event::now_ms())
+            .unwrap_or_else(|| neutrino_event::now_ms() + FALLBACK_TTL_MS);
+        debug!(target: "neutrino_main", %server_name, %key_id, "fetched verify key over HTTP");
+        self.cache.lock().expect("key cache lock").insert(
+            (server_name.to_owned(), key_id.to_owned()),
+            Cached { key, expires_ms },
+        );
+        Ok(key)
+    }
+}
+
+/// A resolver that answers one key, for checking a document against itself.
+struct FixedKey([u8; 32]);
+
+impl KeyResolver for FixedKey {
+    fn verify_key<'a>(
+        &'a self,
+        _server_name: &'a str,
+        _key_id: &'a str,
+    ) -> Pin<Box<dyn Future<Output = Result<[u8; 32], KeyResolveError>> + Send + 'a>> {
+        Box::pin(std::future::ready(Ok(self.0)))
+    }
+}
+
+impl KeyResolver for HttpKeyResolver {
+    fn verify_key<'a>(
+        &'a self,
+        server_name: &'a str,
+        key_id: &'a str,
+    ) -> Pin<Box<dyn Future<Output = Result<[u8; 32], KeyResolveError>> + Send + 'a>> {
+        Box::pin(async move {
+            match self.medium.verify_key(server_name, key_id).await {
+                Ok(key) => return Ok(key),
+                Err(e) => {
+                    debug!(target: "neutrino_main", %server_name, %key_id, reason = %e.reason, "medium resolver declined; fetching by name")
+                }
+            }
+            let cached = self
+                .cache
+                .lock()
+                .expect("key cache lock")
+                .get(&(server_name.to_owned(), key_id.to_owned()))
+                .filter(|c| c.expires_ms > neutrino_event::now_ms())
+                .map(|c| c.key);
+            if let Some(key) = cached {
+                return Ok(key);
+            }
+            self.fetch(server_name, key_id).await.inspect_err(|e| {
+                warn!(target: "neutrino_main", %server_name, %key_id, reason = %e.reason, "verify key unresolved")
+            })
+        })
+    }
+}
