+/// Verify a plain (non-event) JSON object's signature by `origin` under
+/// `key_id` — appendices "Checking for a signature" — over the canonical
+/// form minus `signatures`/`unsigned`. Used for a fetched key document,
+/// which must be signed by the key it advertises.
+pub async fn verify_json_signature(
+    obj: &CanonicalJsonObject,
+    origin: &str,
+    key_id: &str,
+    resolver: &dyn KeyResolver,
+) -> Result<(), String> {
+    let sig = obj
+        .get("signatures")
+        .and_then(|s| match s {
+            CanonicalJsonValue::Object(o) => o.get(origin),
+            _ => None,
+        })
+        .and_then(|s| match s {
+            CanonicalJsonValue::Object(o) => o.get(key_id),
+            _ => None,
+        })
+        .and_then(|s| match s {
+            CanonicalJsonValue::String(s) => Some(s.clone()),
+            _ => None,
+        })
+        .ok_or_else(|| format!("no signature by {origin} under {key_id}"))?;
+    let key = resolver
+        .verify_key(origin, key_id)
+        .await
+        .map_err(|e| e.reason)?;
+    verify_one(&signable_json_bytes(obj), &key, &sig)
+}
