+/// The room's first power levels: the defaults with the request's
+/// `power_level_content_override` merged over them, as the spec says
+/// (`createRoom`: "the power level content to override in the default
+/// power level event"). A call client needs this -- Element Call sets
+/// `org.matrix.msc3401.call.member` to 0 on every room it creates, since
+/// the default `state_default` of 50 keeps every ordinary member out of
+/// the call. Object-valued keys (`events`, `users`, `notifications`) merge
+/// entry by entry; scalars replace. Room v12 forbids naming a creator in
+/// `users` (rule 10.4), so the creator is dropped from an override that
+/// names them: they are all-powerful already.
+fn power_levels_for(sender: &OwnedUserId, override_: Option<&Value>) -> Value {
+    let mut levels = default_power_levels();
+    let Some(Value::Object(override_)) = override_ else {
+        return levels;
+    };
+    for (key, value) in override_ {
+        match (levels.get_mut(key), value) {
+            (Some(Value::Object(existing)), Value::Object(incoming)) => {
+                for (k, v) in incoming {
+                    existing.insert(k.clone(), v.clone());
+                }
+            }
+            _ => {
+                levels[key] = value.clone();
+            }
+        }
+    }
+    if let Some(Value::Object(users)) = levels.get_mut("users") {
+        users.remove(sender.as_str());
+    }
+    levels
+}
