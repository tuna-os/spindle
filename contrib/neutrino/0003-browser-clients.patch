+//! The client-API odds and ends a browser client asks for before it will
+//! sync, none of which a mesh node has any use for: push rules (a phone
+//! that is its own homeserver pushes nothing), sync filters (the node's
+//! sync ignores the filter parameter, so a stored filter is a name and
+//! nothing else), and TURN discovery (no relay on a mesh; the client
+//! proceeds without).
+//!
+//! What made this necessary: matrix-js-sdk's `startClient` fetches push
+//! rules and retries a 404 forever, and creates a sync filter before its
+//! first `/sync`, so a homeserver without both is one the client never
+//! syncs from -- and a full-mesh call (docs/p2p-calls.md in the Spindle
+//! tree) needs the node to be a browser's homeserver.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+use axum::{Json, extract::Path, http::StatusCode, response::IntoResponse};
+use serde_json::{Value, json};
+
+use crate::AuthUser;
+
+static FILTERS: Mutex<Vec<Value>> = Mutex::new(Vec::new());
+static RULES: Mutex<Option<HashMap<String, Value>>> = Mutex::new(None);
+
+/// `GET /pushrules/` — no rules. A node has no push gateway to feed.
+pub async fn push_rules(AuthUser(_): AuthUser) -> Json<Value> {
+    let rules = RULES.lock().unwrap_or_else(|e| e.into_inner());
+    let underride: Vec<Value> = rules
+        .as_ref()
+        .map(|r| r.values().cloned().collect())
+        .unwrap_or_default();
+    Json(json!({
+        "global": { "content": [], "override": [], "room": [], "sender": [], "underride": underride }
+    }))
+}
+
+/// `PUT /pushrules/{scope}/{kind}/{rule_id}` — kept so the client sees
+/// its own rule back, and otherwise ignored.
+pub async fn put_push_rule(
+    AuthUser(_): AuthUser,
+    Path((_scope, kind, rule_id)): Path<(String, String, String)>,
+    body: Json<Value>,
+) -> Json<Value> {
+    let mut rule = body.0;
+    rule["rule_id"] = Value::String(rule_id.clone());
+    rule["default"] = Value::Bool(false);
+    rule["enabled"] = Value::Bool(true);
+    let mut rules = RULES.lock().unwrap_or_else(|e| e.into_inner());
+    rules
+        .get_or_insert_with(HashMap::new)
+        .insert(format!("{kind}/{rule_id}"), rule);
+    Json(json!({}))
+}
+
+/// `POST /user/{user_id}/filter` — a filter is a number; sync ignores it.
+pub async fn create_filter(
+    AuthUser(_): AuthUser,
+    Path(_user_id): Path<String>,
+    body: Json<Value>,
+) -> Json<Value> {
+    let mut filters = FILTERS.lock().unwrap_or_else(|e| e.into_inner());
+    filters.push(body.0);
+    Json(json!({ "filter_id": (filters.len() - 1).to_string() }))
+}
+
+/// `GET /user/{user_id}/filter/{filter_id}` — what was stored.
+pub async fn get_filter(
+    AuthUser(_): AuthUser,
+    Path((_user_id, filter_id)): Path<(String, String)>,
+) -> axum::response::Response {
+    let filters = FILTERS.lock().unwrap_or_else(|e| e.into_inner());
+    match filter_id.parse::<usize>().ok().and_then(|i| filters.get(i)) {
+        Some(filter) => Json(filter.clone()).into_response(),
+        None => (
+            StatusCode::NOT_FOUND,
+            Json(json!({ "errcode": "M_NOT_FOUND", "error": "no such filter" })),
+        )
+            .into_response(),
+    }
+}
+
+/// `GET /voip/turnServer` — no relay: an empty object, which the spec
+/// allows and clients read as "connect directly".
+pub async fn turn_server(AuthUser(_): AuthUser) -> Json<Value> {
+    Json(json!({}))
+}
+
+/// Rewrite `/_matrix/client/r0/…` and `/_matrix/media/r0/…` to `v3`,
+/// query string intact. The endpoints are the same; only the prefix moved.
+pub async fn legacy_prefix(mut request: axum::extract::Request) -> axum::extract::Request {
+    const REWRITES: [(&str, &str); 2] = [
+        ("/_matrix/client/r0/", "/_matrix/client/v3/"),
+        ("/_matrix/media/r0/", "/_matrix/media/v3/"),
+    ];
+    let path = request.uri().path();
+    let Some((from, to)) = REWRITES.iter().find(|(from, _)| path.starts_with(from)) else {
+        return request;
+    };
+    let rewritten = format!("{to}{}", &path[from.len()..]);
+    let with_query = match request.uri().query() {
+        Some(query) => format!("{rewritten}?{query}"),
+        None => rewritten,
+    };
+    let mut parts = request.uri().clone().into_parts();
+    if let Ok(path_and_query) = with_query.parse() {
+        parts.path_and_query = Some(path_and_query);
+        if let Ok(uri) = axum::http::Uri::from_parts(parts) {
+            *request.uri_mut() = uri;
+        }
+    }
+    request
+}
