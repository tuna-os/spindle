/target/
/crates/spindle-server/package-staging/
*.profraw

# Benchmark and interop scratch: databases, signing keys, logs and result
# JSON, none of which belongs in the repository. A run against Synapse leaves
# a homeserver.db and a signing key here, and a Spindle run leaves a fjall
# store -- all of it reproducible, and one of it secret.
/tmp/

# Python bytecode from the helper scripts.
__pycache__/
homeserver.db
homeserver.log
tmp/

# The default storage path is ./data, so a test or a local run that leaves
# `[storage] path` unset writes its store and its media here.
/crates/*/data/
/data/
