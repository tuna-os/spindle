# Copy to .env. Compose reads it from this directory.
SPINDLE_IMAGE=ghcr.io/tuna-os/spindle:v0.1.0@sha256:replace-with-the-digest-from-the-release-notes
# The public host name. It must match server.name and public_base_url in spindle.toml.
SPINDLE_DOMAIN=matrix.example.org
# Optional memory ceiling for the Spindle container.
# SPINDLE_MEM_LIMIT=2g
